# --- Existing auth API settings ---
# Supabase project URL, for example https://your-project-id.supabase.co
SUPABASE_URL=
# Supabase anon key
SUPABASE_KEY=
# Port the Express server listens on
PORT=3000

# --- LLM provider settings (swap provider by changing only these three) ---
# Gemini's OpenAI-compatible endpoint (OpenRouter: https://openrouter.ai/api/v1, Ollama: http://localhost:11434/v1/)
LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
# Your Gemini API key from Google AI Studio (never commit the real value)
LLM_API_KEY=
# Model id; Flash-Lite suits classification and is the free-tier model to rely on (confirm in AI Studio) (OpenRouter: openrouter/free, Ollama: gemma3:1b)
LLM_MODEL=gemini-3.1-flash-lite

# --- Switches (used from Stage 1 and Stage 4) ---
# 1 = skip the model and return a hard-coded valid answer
LLM_STUB=0
# false = kill switch, skip the model and return the fallback
LLM_ENABLED=true
LLM_STUB=1