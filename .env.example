# --- Existing auth API settings ---
# Supabase project URL, for example https://your-project-id.supabase.co
SUPABASE_URL=
# Supabase anon key
SUPABASE_KEY=
# Port the Express server listens on
PORT=3000

# --- LLM provider settings (swap provider by changing only these three) ---
# Gemini's OpenAI-compatible endpoint (OpenRouter: https://openrouter.ai/api/v1, Ollama: http://localhost:11434/v1/)
LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
# Your Gemini API key from Google AI Studio (never commit the real value)
LLM_API_KEY=
# Model id; Flash-Lite suits classification and is the free-tier model to rely on (confirm in AI Studio)
LLM_MODEL=gemini-3.1-flash-lite

# --- Switches ---
# 1 = skip the model and return a hard-coded valid answer
LLM_STUB=0
# false = kill switch: skip the model and return the safe fallback answer
LLM_ENABLED=true

# --- Optional tuning (the defaults are shown) ---
# Request timeout in milliseconds, capped at 60000
LLM_TIMEOUT_MS=30000
# Retries per model call for timeouts, 429 and 5xx (never for 400, 401, 403), capped at 5
LLM_MAX_RETRIES=3
# Low temperature for repeatable answers
LLM_TEMPERATURE=0.2
# Gemini only: how hard the model thinks before answering (minimal or low). minimal cut calls from about 20s to about 2s; remove this line for other providers
LLM_REASONING_EFFORT=minimal

# --- Eval script only (scripts/run-eval.js) ---
# A Supabase test account the eval script logs in with; use a throwaway account, never your real one
EVAL_EMAIL=
EVAL_PASSWORD=
